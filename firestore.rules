rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // -- GLOBALS --
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      // Hardened: In production, use request.auth.token.email_verified == true
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSuperAdmin() {
      return isSignedIn() && 
        (
          (request.auth.token.email != null && request.auth.token.email.lower() == 'masriboro@gmail.com') ||
          request.auth.uid == 'NiDR1AAMDuTGXqbYXfIs4TTijRk2'
        );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSupplier() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supplier';
    }

    // -- VALIDATION HELPERS --

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'createdAt'])
        && data.userId is string
        && data.title is string && data.title.size() <= 100
        && data.message is string && data.message.size() <= 1500
        && data.read is bool;
    }

    function isValidBroadcast(data) {
      return data.keys().hasAll(['title', 'message', 'target', 'createdAt'])
        && data.title is string && data.title.size() <= 100
        && data.message is string && data.message.size() <= 1500
        && data.target in ['all', 'buyer', 'supplier'];
    }

    function isValidOffer(data) {
      return data.keys().hasAll(['supplierId', 'title', 'originalPrice', 'offerPrice'])
        && data.supplierId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.originalPrice is number
        && data.offerPrice is number
        && (data.stock == null || data.stock is number)
        && (data.unit == null || data.unit is string);
    }

    function isValidUnit(data) {
      return data.keys().hasAll(['name', 'abbreviation', 'type', 'isStandard']) &&
             data.name is string && data.type in ['mass', 'volume', 'count', 'other'];
    }

    function isValidConversion(data) {
      return data.keys().hasAll(['fromUnitId', 'toUnitId', 'multiplier']) &&
             data.fromUnitId is string && data.toUnitId is string && data.multiplier is number;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['supplierId', 'supplierName', 'name', 'basePrice', 'baseUnitId', 'category']) &&
             (isAdmin() || data.supplierId == request.auth.uid) &&
             data.name is string && data.name.size() <= 200 &&
             data.basePrice is number && data.basePrice >= 0 &&
             data.baseUnitId is string &&
             (data.stock == null || data.stock is number);
    }

    function isValidCart(data) {
      return data.keys().hasAll(['items', 'updatedAt']) &&
             data.items is list;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['buyerId', 'totalAmount', 'status', 'createdAt']) &&
             data.buyerId == request.auth.uid &&
             data.totalAmount is number &&
             data.status in ['pending', 'confirmed', 'processing', 'preparing', 'shipped', 'delivered', 'cancelled', 'rejected', 'partially_fulfilled'];
    }

    function isValidSupplierOrder(data) {
      return data.keys().hasAll(['parentOrderId', 'supplierId', 'total', 'status']) &&
             data.total is number &&
             data.status in ['pending', 'confirmed', 'processing', 'preparing', 'shipped', 'delivered', 'cancelled', 'rejected', 'partially_fulfilled'];
    }

    // -- COLLECTIONS --

    match /units/{unitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /conversions/{convId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /payment_methods/{methodId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /supplier_orders/{sOrderId} {
      allow read: if isSignedIn() && (
        resource.data.get('supplierId', '') == request.auth.uid || 
        resource.data.get('buyerId', '') == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.get('supplierId', '') == request.auth.uid || isAdmin());
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && (isSupplier() || isAdmin()) && isValidId(productId) && isValidProduct(incoming());
      allow update: if isSignedIn() && (isAdmin() || (isSupplier() && resource.data.supplierId == request.auth.uid)) && isValidProduct(incoming());
      allow delete: if isSignedIn() && (isAdmin() || (isSupplier() && resource.data.supplierId == request.auth.uid));
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create: if isSignedIn() && (isSupplier() || isAdmin()) && isValidId(offerId) && isValidOffer(incoming());
      allow update: if (isAdmin() || (isSignedIn() && isSupplier() && existing().supplierId == request.auth.uid)) && isValidOffer(incoming()) 
                     || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['orders', 'updatedAt']));
      allow delete: if isAdmin() || (isSignedIn() && isSupplier() && existing().supplierId == request.auth.uid);
    }

    match /{path=**}/bids/{bidId} {
      allow list: if isSignedIn() && (
        resource.data.supplierId == request.auth.uid || 
        isAdmin() ||
        (resource.data.keys().contains('requestId') && get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.buyerId == request.auth.uid)
      );
      allow get: if isSignedIn();
    }

    match /requests/{requestId}/bids/{bidId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(bidId) && incoming().supplierId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.supplierId == request.auth.uid || 
        isAdmin() ||
        (get(/databases/$(database)/documents/requests/$(requestId)).data.buyerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      allow delete: if isSignedIn() && (resource.data.supplierId == request.auth.uid || isAdmin());
    }

    match /requests/{requestId} {
      allow list: if resource.data.status == 'active' || (isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.supplierId == request.auth.uid ||
        isAdmin()
      ));
      allow get: if true;
      allow create: if isSignedIn() && isValidId(requestId) && incoming().buyerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.supplierId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow list, get: if isSignedIn();
        allow create: if isSignedIn() && isValidId(messageId);
      }
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.get('buyerId', '') == request.auth.uid || 
        resource.data.get('supplierId', '') == request.auth.uid ||
        resource.data.get('supplierOrders', []).size() > 0 || 
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(orderId);
      allow update: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow list, get: if isSignedIn();
        allow create: if isSignedIn() && isValidId(messageId);
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn(); 
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /system_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /system_logs/{logId} {
      allow create: if true; // Allow anyone to log (including public errors)
      allow read: if isAdmin();
    }

    match /system_alerts/{alertId} {
      allow create: if true;
      allow read, update: if isAdmin();
    }

    match /exclusive_offers/{offerId} {
      allow read: if true;
      allow create: if isSignedIn() && isSupplier() && isValidId(offerId);
      allow update: if isSignedIn() && (isAdmin() || (resource.data.supplierId == request.auth.uid));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.supplierId == request.auth.uid);
    }

    match /subscription_requests/{requestId} {
      allow list, get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(requestId) && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /subscription_payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /page_stats/{pathId} {
      allow read: if true;
      allow create, update: if true; // Publicly trackable
    }

    match /offer_stats/{offerId} {
      allow read: if true;
      allow create, update: if true; // Publicly trackable
    }
  }
}
