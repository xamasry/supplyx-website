{
  "entities": {
    "Unit": {
      "title": "Unit of Measurement",
      "description": "Standard units like kg, liter, carton, etc.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "abbreviation": { "type": "string" },
        "type": { "type": "string", "enum": ["mass", "volume", "count", "other"] },
        "isStandard": { "type": "boolean" }
      },
      "required": ["name", "abbreviation", "type", "isStandard"]
    },
    "UnitConversion": {
      "title": "Unit Conversion",
      "description": "Conversion rules between units",
      "type": "object",
      "properties": {
        "fromUnitId": { "type": "string" },
        "toUnitId": { "type": "string" },
        "multiplier": { "type": "number" }
      },
      "required": ["fromUnitId", "toUnitId", "multiplier"]
    },
    "PackagingLevel": {
      "title": "Packaging Level",
      "description": "Specific packaging configurations for products",
      "type": "object",
      "properties": {
        "unitId": { "type": "string" },
        "name": { "type": "string" },
        "quantityInBaseUnit": { "type": "number" },
        "price": { "type": "number" },
        "stock": { "type": "number" }
      },
      "required": ["unitId", "name", "quantityInBaseUnit", "price"]
    },
    "Product": {
      "title": "Supplier Product",
      "description": "Enterprise catalog item",
      "type": "object",
      "properties": {
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "basePrice": { "type": "number" },
        "baseUnitId": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "available": { "type": "boolean" },
        "moq": { "type": "number" },
        "stock": { "type": "number" },
        "packagingLevels": { 
          "type": "array", 
          "items": { "$ref": "PackagingLevel" } 
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["supplierId", "name", "basePrice", "baseUnitId", "category"]
    },
    "Cart": {
      "title": "Shopping Cart",
      "description": "Persistent cross-device cart",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "supplierId": { "type": "string" },
              "packagingLevelId": { "type": "string" },
              "quantity": { "type": "number" },
              "unitId": { "type": "string" },
              "priceAtAddition": { "type": "number" },
              "notes": { "type": "string" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Parent Order",
      "description": "Aggregated order across multiple suppliers",
      "type": "object",
      "properties": {
        "buyerId": { "type": "string" },
        "buyerName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled", "partially_fulfilled"] },
        "shippingAddress": { "type": "string" },
        "contactPhone": { "type": "string" },
        "supplierOrderIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerId", "totalAmount", "status", "createdAt"]
    },
    "SupplierOrder": {
      "title": "Supplier Specific Order",
      "description": "Order segment fulfilled by a single supplier",
      "type": "object",
      "properties": {
        "parentOrderId": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "productName": { "type": "string" },
              "unitId": { "type": "string" },
              "unitName": { "type": "string" },
              "quantity": { "type": "number" },
              "pricePerUnit": { "type": "number" },
              "totalPrice": { "type": "number" },
              "notes": { "type": "string" }
            }
          }
        },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled", "partially_fulfilled"] },
        "deliveryDate": { "type": "string", "format": "date-time" }
      },
      "required": ["parentOrderId", "supplierId", "total", "status"]
    },
    "Category": {
      "title": "Product Category",
      "description": "Formalized category system",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "businessName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "role": { "type": "string", "enum": ["buyer", "supplier", "admin"] },
        "isApproved": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "System event notification",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["bid_accepted", "new_bid", "system", "order_update", "inventory_alert"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "link": { "type": "string" }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt"]
    }
  },
  "firestore": {
    "/units/{unitId}": {
      "schema": "Unit",
      "description": "Available units"
    },
    "/conversions/{convId}": {
      "schema": "UnitConversion",
      "description": "Global unit conversion rules"
    },
    "/categories/{catId}": {
      "schema": "Category",
      "description": "Product categories"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Supplier catalog products"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Enterprise B2B orders"
    },
    "/supplier_orders/{sOrderId}": {
      "schema": "SupplierOrder",
      "description": "Supplier fulfillment orders"
    },
    "/carts/{userId}": {
      "schema": "Cart",
      "description": "User shopping carts"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    }
  }
}
